# Dragonbound — Git LFS rules.
# Run `git lfs install` once per machine before first clone/commit.

# --- Unreal binary assets (required for uasset/umap to diff/pull correctly) ---
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text

# NOTE: LFS on uasset/umap is the standard GitHub workflow but LFS-locked files
# cannot be edited by two people simultaneously. If the team later adopts
# Perforce-style exclusive checkout or `git lfs lock`, revisit this section.

# --- Source art (DCC files — large binaries) ---
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.obj   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.ma    filter=lfs diff=lfs merge=lfs -text
*.mb    filter=lfs diff=lfs merge=lfs -text
*.zpr   filter=lfs diff=lfs merge=lfs -text
*.spp   filter=lfs diff=lfs merge=lfs -text
*.hip   filter=lfs diff=lfs merge=lfs -text
*.hipnc filter=lfs diff=lfs merge=lfs -text

